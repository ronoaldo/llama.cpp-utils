#!/usr/bin/env bash

# llama-installer: Automates the installation/update of llama.cpp (Vulkan x64)
# Target: Ubuntu AMD64

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
source "$SCRIPT_DIR/utils.sh"

# --- Configuration ---
REPO="ggml-org/llama.cpp"
INSTALL_BASE="$HOME/.local/share/llama.cpp"
BIN_DIR="$HOME/.local/bin"
LINK_NAME="llama"
TEMP_DIR=$(mktemp -d -t llama_install_XXXXXX)

# Automatic cleanup on exit (success or error)
cleanup() {
    rm -rf "$TEMP_DIR"
}
trap cleanup EXIT

# --- Check Only Function ---
check_only() {
    log_step "Checking for updates..."

    # 1. Get the latest release tag via GitHub API
    TAG=$(curl -s "https://api.github.com/repos/$REPO/releases/latest" | jq -r .tag_name)

    if [[ -z "$TAG" || "$TAG" == "null" ]]; then
        die "Failed to fetch the latest tag from GitHub."
    fi

    # 2. Identify the currently installed version via the symlink
    if [ -L "$BIN_DIR/$LINK_NAME" ]; then
        ACTUAL_BIN_PATH=$(readlink -f "$BIN_DIR/$LINK_NAME")
        CURRENT_VERSION_DIR=$(dirname "$ACTUAL_BIN_PATH")
        CURRENT_TAG=$(basename "$CURRENT_VERSION_DIR")
        
        log_info "Current version: $CURRENT_TAG"
        log_info "Latest version: $TAG"

        if [ "$CURRENT_TAG" != "$TAG" ]; then
            log_success "A new version is available!"
            CHANGELOG_URL="https://github.com/$REPO/compare/$CURRENT_TAG...$TAG"
            log_info "You can view the changelog here: $CHANGELOG_URL"
        else
            log_success "You are already using the latest version: $TAG"
        fi
    else
        log_warn "No existing installation found (no symbolic link at $BIN_DIR/$LINK_NAME)."
        log_info "Run the installer normally to install."
    fi
}

# --- Main Logic ---
main() {
    check_dep "curl"
    check_dep "jq"
    check_dep "tar"

    if [[ "$1" == "--check-only" ]]; then
        check_only
        return 0
    fi

    log_step "Fetching the latest release tag from GitHub..."
    TAG=$(curl -s "https://api.github.com/repos/$REPO/releases/latest" | jq -r .tag_name)
    
    if [[ -z "$TAG" || "$TAG" == "null" ]]; then
        die "Failed to fetch the latest tag from GitHub."
    fi
    log_info "Latest version identified: $TAG"

    TARGET_DIR="$INSTALL_BASE/$TAG"

    if [ -d "$TARGET_DIR" ]; then
        log_success "Version $TAG is already installed in $TARGET_DIR. Skipping download."
    else
        log_info "Installing version $TAG in $TARGET_DIR..."
        mkdir -p "$TARGET_DIR"

        log_step "Downloading Vulkan x64 binary..."
        URL=$(curl -s "https://api.github.com/repos/$REPO/releases/latest" | jq -r '.assets[] | select(.name | contains("vulkan-x64.tar.gz")) | .browser_download_url')
        
        if [[ -z "$URL" || "$URL" == "null" ]]; then
            die "Could not find the download link for the Vulkan x64 binary."
        fi

        log_info "Downloading from: $URL"
        if ! curl -L "$URL" -o "$TEMP_DIR/llama.tar.gz"; then
            die "The download failed."
        fi

        log_step "Extracting files..."
        mkdir -p "$TEMP_DIR/extracted"
        if ! tar -xzf "$TEMP_DIR/llama.tar.gz" -C "$TEMP_DIR/extracted"; then
            die "Failed to extract the downloaded file."
        fi
        
        BIN_PATH=$(find "$TEMP_DIR/extracted" -name "llama-cli" | head -n 1)
        if [ -z "$BIN_PATH" ]; then
            die "Could not find the llama-cli binary within the downloaded package."
        fi
        BIN_DIR_IN_TAR=$(dirname "$BIN_PATH")
        
        cp -r "$BIN_DIR_IN_TAR/." "$TARGET_DIR/"
    fi

    log_step "Configuring symbolic link..."
    mkdir -p "$BIN_DIR"
    
    ACTUAL_BIN=$(find "$TARGET_DIR" -maxdepth 1 -name "llama" | head -n 1)
    
    if [ -z "$ACTUAL_BIN" ]; then
        die "Could not find the llama-cli binary in $TARGET_DIR"
    fi

    ln -sf "$ACTUAL_BIN" "$BIN_DIR/$LINK_NAME"
    log_success "Symbolic link created: $BIN_DIR/$LINK_NAME -> $ACTUAL_BIN"

    if [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
        log_warn "Adding $BIN_DIR to PATH in ~/.bashrc"
        if [ -f "$HOME/.bashrc" ]; then
            if ! grep -q "export PATH=\"\$HOME/.local/bin:\$PATH\"" "$HOME/.bashrc"; then
                echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
                log_warn "Please run 'source ~/.bashrc' or restart your terminal to update the PATH."
            else
                log_info "$BIN_DIR is already in ~/.bashrc."
            fi
        else
            log_warn "$HOME/.bashrc not found. The PATH was not updated permanently."
        fi
    else
        log_info "$BIN_DIR is already in the PATH."
    fi

    log_step "Verifying installation..."
    VERSION_OUTPUT=$("$BIN_DIR/$LINK_NAME" --version 2>&1)
    CLEAN_TAG=$(echo "$TAG" | sed 's/^[bv]//')

    if echo "$VERSION_OUTPUT" | grep -q "$CLEAN_TAG"; then
        log_success "llama-installer completed successfully!"
    else
        die "Verification failed. Detected: [$VERSION_OUTPUT]. Expected: [$CLEAN_TAG] (Original tag: $TAG)."
    fi
}

main "$@"
