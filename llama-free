#!/usr/bin/env bash
set -e

# Default server URL
LLAMA_SERVER_URL="http://localhost:1234"

# Fetch loaded models and send unload requests
curl -fsS "$LLAMA_SERVER_URL/v1/models" | jq -r '.data[] | select(.status.value == "loaded") | .id' | while IFS= read -r model_id; do
    echo -n "Unloading: $model_id: "
    curl -fsS -X POST "$LLAMA_SERVER_URL/models/unload" \
        -H "Content-Type: application/json" \
        -d "{\"model\": \"$model_id\"}"
	echo
done
echo "All models unloaded."

