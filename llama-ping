#!/usr/bin/env bash

# Configuration
API_URL="http://0.0.0.0:8084/v1/chat/completions"
MODELS_URL="http://0.0.0.0:8084/v1/models"

fetch_models() {
    local response
    response=$(curl -s "$MODELS_URL")
    if [ -z "$response" ]; then
        echo "Error: Could not fetch models from server."
        exit 1
    fi

    echo "Available models:"
    echo "$response" | jq -r '.data[] | "\(.id) \(.status.value) \(.status.args | join(" "))"' | while read -r id loaded args; do
        local status=""
        [ "$loaded" = "loaded" ] && status=" (loaded)"
        local context="N/A"
        if [ -n "$args" ]; then
            context=$(echo "$args" | grep -oP '(?<=\--ctx-size )\K\d+' | head -1)
        fi
        echo "- $id$status (Context: ${context:-N/A})"
    done
}

get_payload() {
    local model_alias=$1
    local prompt=$2
    jq -n \
        --arg model "$model_alias" \
        --arg prompt "$prompt" \
        '{model: $model, messages: [{role: "user", content: $prompt}], temperature: 0}'
}

call_api() {
    local payload=$1
    curl -s -X POST "$API_URL" \
        -H "Content-Type: application/json" \
        -d "$payload"
}

handle_response() {
    local response=$1
    local prompt=$2

    if [ -z "$response" ]; then
        echo -e "\nError: Empty response from server."
        exit 1
    fi

    local error_msg=$(echo "$response" | jq -r '.error.message // empty')
    if [ -n "$error_msg" ]; then
        echo -e "\nServer Error: $error_msg"
        exit 1
    fi

    local content=$(echo "$response" | jq -r '.choices[0].message.content')
    local prompt_n=$(echo "$response" | jq -r '.timings.prompt_n')
    local prompt_tps=$(echo "$response" | jq -r '.timings.prompt_per_second')
    local pred_n=$(echo "$response" | jq -r '.timings.predicted_n')
    local pred_tps=$(echo "$response" | jq -r '.timings.predicted_per_second')

    echo -ne "User: ${prompt}\n  AI: "
    echo "$content"
    echo
    echo "Prompt: $prompt_n tokens @ $prompt_tps tokens/s"
    echo "Generated: $pred_n tokens @ $pred_tps tokens/s"
}

main() {
    if [ -z "$1" ]; then
        fetch_models
        exit 0
    fi

    local model_alias=$1
    local prompt=${2:-"Hello"}

    local payload=$(get_payload "$model_alias" "$prompt")
    
    echo -ne "User: ${prompt}\n  AI: "
    local response=$(call_api "$payload")

    handle_response "$response" "$prompt"
}

main "$@"
