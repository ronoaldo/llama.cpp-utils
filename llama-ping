#!/usr/bin/env bash

# Configuration
API_URL="http://0.0.0.0:8084/v1/chat/completions"

# Argument validation
# We only check if the first argument (model alias) was provided
if [ -z "$1" ]; then
    MODELS_RESPONSE=$(curl -s http://0.0.0.0:8084/v1/models)
    if [ -z "$MODELS_RESPONSE" ]; then
        echo "Error: Could not fetch models from server."
        exit 1
    fi

    echo "Available models:"
    echo "$MODELS_RESPONSE" | jq -r '.data[] | "\(.id) \(.status.value) \(.status.args | join(" "))"' | while read -r id loaded args; do
        status=""
        [ "$loaded" = "loaded" ] && status=" (loaded)"
        context="N/A"
        if [ -n "$args" ]; then
            context=$(echo "$args" | grep -oP '(?<=\--ctx-size )\K\d+' | head -1)
        fi
        echo "- $id$status (Context: ${context:-N/A})"
    done
    exit 0
fi

MODEL_ALIAS=$1
# If $2 is not provided, PROMPT defaults to "Hello"
PROMPT=${2:-"Hello"}

# Safe payload construction using jq
PAYLOAD=$(jq -n \
    --arg model "$MODEL_ALIAS" \
    --arg prompt "$PROMPT" \
    '{model: $model, messages: [{role: "user", content: $prompt}], temperature: 0}')

echo -ne "User: ${PROMPT}\n  AI: "

# Execute request and store response
RESPONSE=$(curl -s -X POST "$API_URL" \
    -H "Content-Type: application/json" \
    -d "$PAYLOAD")

# Check if response is empty
if [ -z "$RESPONSE" ]; then
    echo -e "\nError: Empty response from server."
    exit 1
fi

# Check for JSON errors (e.g., model not found)
ERROR_MSG=$(echo "$RESPONSE" | jq -r '.error.message // empty')
if [ -n "$ERROR_MSG" ]; then
    echo -e "\nServer Error: $ERROR_MSG"
    exit 1
fi

# Data extraction using jq
CONTENT=$(echo "$RESPONSE" | jq -r '.choices[0].message.content')
PROMPT_N=$(echo "$RESPONSE" | jq -r '.timings.prompt_n')
PROMPT_TPS=$(echo "$RESPONSE" | jq -r '.timings.prompt_per_second')
PRED_N=$(echo "$RESPONSE" | jq -r '.timings.predicted_n')
PRED_TPS=$(echo "$RESPONSE" | jq -r '.timings.predicted_per_second')

# Formatted output
echo "$CONTENT"
echo
echo "Prompt: $PROMPT_N tokens @ $PROMPT_TPS tokens/s"
echo "Generated: $PRED_N tokens @ $PRED_TPS tokens/s"
